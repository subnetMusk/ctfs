# ---- Demo environment variables ----
# Flask secret key for session cookies (demo only)
SECRET_KEY=please-change-me

# Postgres settings (used by the db service)
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=appdb

# SQLAlchemy connection string (used by web service), host is the service name 'db'
DATABASE_URL=postgresql+psycopg2://app:app@db:5432/appdb
